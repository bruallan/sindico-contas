# Credenciais do Projeto Supabase
# Caso não sejam preenchidas, o sistema opera automaticamente em Modo Local Persistente (Demo/Sandbox)
# com dados pré-carregados para inspeção imediata de todos os fluxos.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# E-mail do Administrador Master (opcional para fallback além de app_metadata.role = 'admin')
VITE_ADMIN_EMAIL=admin@sindicocontas.com.br
